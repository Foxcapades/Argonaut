//    graph[label="argo/command (cli)"]
//
//    { // Returns
//      edge[arrowsize="1.25", color="indigo"]
//
//    }
//
//    { // Implements
//      edge[color="steelblue4", dir="none", arrowsize="0.75", style="dashed"]
//
//    }
//
//    { // Constructs
//      edge[color="violetred", arrowhead="icurve", style="dotted", penwidth="1.5"]
//
//    }
//  }

}